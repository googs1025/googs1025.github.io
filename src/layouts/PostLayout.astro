---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";

import TableOfContents from "@/components/TableOfContents.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryPath, hasMeaningfulUpdate, postPath } from "@/lib/posts.mjs";

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
  previous?: CollectionEntry<"blog">;
  next?: CollectionEntry<"blog">;
}

const { post, headings, previous, next } = Astro.props;
const { data } = post;
const canonical = data.canonicalURL
  ?? new URL(postPath(post.id), Astro.site ?? Astro.url.origin);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  dateStyle: "long",
  timeZone: "UTC",
});
const showUpdatedDate = hasMeaningfulUpdate(data.pubDate, data.updatedDate);
const modifiedTime = showUpdatedDate && data.updatedDate
  ? data.updatedDate.toISOString()
  : undefined;
const postHref = (entry: CollectionEntry<"blog">) =>
  entry.data.canonicalURL ?? postPath(entry.id);
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  ogType="article"
  articlePublishedTime={data.pubDate.toISOString()}
  articleModifiedTime={modifiedTime}
>
  <div class="content post-page">
    <header class="post-header">
      <h1>{data.title}</h1>
      <div class="post-meta">
        <span>
          发布于
          <time datetime={data.pubDate.toISOString()}>
            {dateFormatter.format(data.pubDate)}
          </time>
        </span>
        {
          showUpdatedDate && data.updatedDate && (
            <span>
              更新于
              <time datetime={data.updatedDate.toISOString()}>
                {dateFormatter.format(data.updatedDate)}
              </time>
            </span>
          )
        }
        {
          data.categories.length > 0 && (
            <span class="post-categories" aria-label="文章分类">
              {data.categories.map((category) => (
                <a
                  class="badge"
                  href={categoryPath(category)}
                >
                  {category}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <TableOfContents headings={headings} />

    <article class="prose" data-pagefind-body>
      <slot />
    </article>

    {
      (previous || next) && (
        <nav class="post-navigation" aria-label="文章导航">
          {previous && (
            <a class="post-navigation-previous" href={postHref(previous)} rel="prev">
              <span>上一篇</span>
              <strong>{previous.data.title}</strong>
            </a>
          )}
          {next && (
            <a class="post-navigation-next" href={postHref(next)} rel="next">
              <span>下一篇</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )
    }
  </div>
</BaseLayout>
