---
import { PROFILE } from "@/data/profile.mjs";
import { SITE } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const emailHref = `mailto:${SITE.email}`;
---

<BaseLayout
  title="About"
  description={`${PROFILE.identity.name}（${PROFILE.identity.latinName}）的开源方向、社区角色与 MUSA 生态实践。`}
>
  <article class="content profile-page" data-pagefind-body>
    <section class="profile-intro" aria-labelledby="profile-name">
      <img
        class="profile-image"
        src="/images/profile.jpg"
        alt={PROFILE.identity.name}
        width="420"
        height="600"
      />
      <div>
        <p class="profile-label">About</p>
        <h1 id="profile-name">{PROFILE.identity.latinName}</h1>
        <p class="profile-handle">
          {PROFILE.identity.latinName} · {PROFILE.identity.handle}
        </p>
        <h2 id="about-me">1. About Me</h2>
        <blockquote>
          <p>{PROFILE.identity.summary}</p>
          {PROFILE.experience.map((item) => <p>{item.summary}</p>)}
          <p>{PROFILE.identity.motto}</p>
        </blockquote>
      </div>
    </section>

    <section class="profile-section" aria-labelledby="about-focus">
      <h2 id="about-focus">2. Open Source Focus</h2>
      {PROFILE.openSourceFocus.map((focus) => (
        <div class="cv-entry">
          <h3>{focus.topic}</h3>
          <p>{focus.description}</p>
        </div>
      ))}
    </section>

    <section class="profile-section" aria-labelledby="about-open-source">
      <h2 id="about-open-source">3. Open Source Roles &amp; Recognition</h2>
      {PROFILE.openSourceRoles.map((item) => (
        <div class="cv-entry">
          <h3><a href={item.url}>{item.project}</a>{" "}{item.role}</h3>
          <p>{item.description}</p>
        </div>
      ))}
      {PROFILE.recognitions.map((item) => (
        <div class="cv-entry">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <p><a href={item.url}>Official recognition</a></p>
        </div>
      ))}
      {PROFILE.roleGroups.map((group) => (
        <div class="cv-entry">
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <ul class="role-list">
            {group.projects.map((project) => (
              <li><a href={project.url}>{project.project}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="profile-section" aria-labelledby="about-musa">
      <h2 id="about-musa">4. MUSA Ecosystem</h2>
      {PROFILE.musaProjects.map((project) => (
        <div class="cv-entry">
          <h3><a href={project.url}>{project.project}</a></h3>
          <p>{project.description}</p>
        </div>
      ))}
    </section>

    <section class="profile-section" aria-labelledby="about-exploring">
      <h2 id="about-exploring">5. Currently Exploring</h2>
      <ul class="fact-list">
        {PROFILE.exploring.map((topic) => <li>{topic}</li>)}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-contact">
      <h2 id="about-contact">6. Contact</h2>
      <ul class="contact-list">
        <li><a href={emailHref}>Email: {SITE.email}</a></li>
        <li><a href={SITE.github}>GitHub: {SITE.handle.replace(/^@/, "")}</a></li>
        <li>WeChat: googs1025</li>
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-chinese">
      <h2 id="about-chinese">7. 中文简介</h2>
      <blockquote>
        {PROFILE.chineseSummary.map((paragraph) => <p>{paragraph}</p>)}
      </blockquote>
    </section>
  </article>
</BaseLayout>
