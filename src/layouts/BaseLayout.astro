---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
}

const {
  title,
  description = SITE.description,
  canonical,
} = Astro.props;
const documentTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonicalURL = canonical
  ? new URL(canonical, SITE.url)
  : new URL(Astro.url.pathname, SITE.url);
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        let theme = window.matchMedia?.("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        try {
          const storedTheme = localStorage.getItem("theme");
          if (storedTheme === "light" || storedTheme === "dark") {
            theme = storedTheme;
          }
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          theme === "dark" ? "#0d0f10" : "#ffffff",
        );
      })();
    </script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={new URL("/rss.xml", SITE.url)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
