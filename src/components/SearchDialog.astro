<div class="search-controller" data-search-root>
  <button
    class="icon-button"
    type="button"
    aria-label="搜索文章"
    title="搜索文章"
    aria-haspopup="dialog"
    data-search-open
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
      <circle cx="11" cy="11" r="6.5"></circle>
      <path d="m16 16 4 4"></path>
    </svg>
  </button>

  <dialog class="search-dialog" aria-label="全文搜索" data-search-dialog>
    <div class="search-dialog-inner">
      <div class="search-dialog-header">
        <h2>全文搜索</h2>
        <form method="dialog">
          <button class="icon-button" type="submit" aria-label="关闭搜索" title="关闭搜索">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
          </button>
        </form>
      </div>

      <label class="search-field">
        <span>搜索关键词</span>
        <input
          type="search"
          inputmode="search"
          autocomplete="off"
          placeholder="输入文章标题或正文关键词"
          data-search-input
        />
      </label>

      <p class="search-status" aria-live="polite" aria-atomic="true" data-search-status>
        输入关键词开始搜索
      </p>
      <ul class="search-results" data-search-results></ul>
    </div>
  </dialog>
</div>

<script>
  import {
    createPagefindLoader,
    setupSearchDialog,
  } from "@/lib/search-dialog.mjs";
  import { searchResultView } from "@/lib/search.mjs";

  type SearchData = {
    url?: unknown;
    excerpt?: unknown;
    plain_excerpt?: unknown;
    meta?: Record<string, unknown>;
  };
  const pagefindPath = "/pagefind/pagefind.js";
  const loadPagefind = createPagefindLoader(() =>
    import(/* @vite-ignore */ pagefindPath),
  );

  const createResult = (result: SearchData) => {
    const item = searchResultView(result);
    const listItem = document.createElement("li");
    const article = document.createElement("article");
    const title = document.createElement("h3");
    const link = document.createElement("a");
    const description = document.createElement("p");

    link.setAttribute("href", item.href);
    link.textContent = item.title;
    description.textContent = item.description;
    title.append(link);
    article.append(title, description);
    listItem.append(article);

    return listItem;
  };

  const showEmptyResult = (results: HTMLUListElement) => {
    const item = document.createElement("li");
    const message = document.createElement("p");

    message.className = "empty-state";
    message.textContent = "没有找到相关文章";
    item.append(message);
    results.replaceChildren(item);
  };

  for (const root of document.querySelectorAll("[data-search-root]")) {
    const trigger = root.querySelector("[data-search-open]");
    const dialog = root.querySelector("[data-search-dialog]");
    const input = root.querySelector("[data-search-input]");
    const status = root.querySelector("[data-search-status]");
    const results = root.querySelector("[data-search-results]");

    if (
      !(trigger instanceof HTMLButtonElement) ||
      !(dialog instanceof HTMLDialogElement) ||
      !(input instanceof HTMLInputElement) ||
      !(status instanceof HTMLElement) ||
      !(results instanceof HTMLUListElement)
    ) {
      continue;
    }

    setupSearchDialog({
      trigger,
      dialog,
      input,
      status,
      results,
      loadPagefind,
      renderResult: createResult,
      renderEmpty: showEmptyResult,
    });
  }
</script>
