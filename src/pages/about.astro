---
import { PROFILE } from "@/data/profile.mjs";
import { SITE } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";

const emailHref = `mailto:${SITE.email}`;
---

<BaseLayout
  title="About"
  description={`${PROFILE.identity.name}（${PROFILE.identity.latinName}）的个人简介、工作方向与开源社区参与。`}
>
  <article class="content profile-page" data-pagefind-body>
    <header class="profile-intro">
      <img
        class="profile-image"
        src="/images/profile.jpg"
        alt={PROFILE.identity.name}
        width="420"
        height="600"
      />
      <div>
        <p class="profile-label">About</p>
        <h1>{PROFILE.identity.name}</h1>
        <p class="profile-handle">
          {PROFILE.identity.latinName} · {PROFILE.identity.handle}
        </p>
        <p class="profile-summary">{PROFILE.identity.summary}</p>
      </div>
    </header>

    <section class="profile-section" aria-labelledby="about-work">
      <h2 id="about-work">工作</h2>
      <ul class="fact-list">
        {PROFILE.experience.map((item) => <li>{item.summary}</li>)}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-focus">
      <h2 id="about-focus">技术方向</h2>
      <ul class="fact-list">
        {PROFILE.technicalFocus.map((focus) => <li>{focus}</li>)}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-open-source">
      <h2 id="about-open-source">开源角色与社区</h2>
      <ul class="role-list">
        {PROFILE.openSourceRoles.map((item) => (
          <li>
            <a href={item.url}>{item.project}</a>{" "}{item.role}
          </li>
        ))}
        {PROFILE.recognitions.map((item) => (
          <li><a href={item.url}>{item.title}</a></li>
        ))}
        {PROFILE.collaborations.map((item) => (
          <li><a href={item.url}>{item.project}</a>：{item.activity}</li>
        ))}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-open-source-focus">
      <h2 id="about-open-source-focus">开源方向</h2>
      {PROFILE.openSourceFocus.map((focus) => (
        <div class="cv-entry">
          <h3>{focus.topic}</h3>
          <ul class="role-list">
            {focus.projects.map((project) => (
              <li><a href={project.url}>{project.project}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="profile-section" aria-labelledby="about-musa">
      <h2 id="about-musa">MUSA 生态项目</h2>
      <ul class="role-list">
        {PROFILE.musaProjects.map((project) => (
          <li>
            <a href={project.url}>{project.project}</a>：{project.description}
          </li>
        ))}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-exploring">
      <h2 id="about-exploring">正在探索</h2>
      <ul class="fact-list">
        {PROFILE.exploring.map((topic) => <li>{topic}</li>)}
      </ul>
    </section>

    <section class="profile-section" aria-labelledby="about-summary">
      <h2 id="about-summary">中文简介</h2>
      <p>{PROFILE.chineseSummary}</p>
    </section>

    <section class="profile-section" aria-labelledby="about-contact">
      <h2 id="about-contact">联系</h2>
      <ul class="contact-list">
        <li><a href={SITE.github}>GitHub · {SITE.handle.replace(/^@/, "")}</a></li>
        <li><a href={emailHref}>{SITE.email}</a></li>
        <li>WeChat · googs1025</li>
      </ul>
    </section>
  </article>
</BaseLayout>
