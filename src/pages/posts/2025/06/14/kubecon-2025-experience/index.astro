---
import BaseLayout from "@/layouts/BaseLayout.astro";

const destination = "/posts/kubecon-china-2025/";
const canonicalURL = new URL(destination, Astro.site ?? Astro.url.origin);
---

<BaseLayout title="文章已迁移" canonical={canonicalURL}>
  <meta slot="head" http-equiv="refresh" content={`0; url=${destination}`} />
  <section class="content legacy-message" aria-labelledby="legacy-title">
    <h1 id="legacy-title">文章已迁移</h1>
    <p>
      正在前往新地址。若浏览器没有自动跳转，请<a href={destination}>继续阅读</a>。
    </p>
  </section>
</BaseLayout>
