---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { SITE } from "@/data/site";

const navigation = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/cv/", label: "CV" },
] as const;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">CYJiang</span>
      <span class="brand-name">江振瑜</span>
      <span class="brand-handle">{SITE.handle}</span>
    </a>

    <div class="desktop-navigation">
      <nav aria-label="主导航">
        <ul class="nav-list">
          {navigation.map(({ href, label }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="icon-button" href="/blog/" aria-label="搜索文章" title="搜索文章">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>

    <div class="mobile-navigation">
      <a class="icon-button" href="/blog/" aria-label="搜索文章" title="搜索文章">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <circle cx="11" cy="11" r="6.5"></circle>
          <path d="m16 16 4 4"></path>
        </svg>
      </a>
      <ThemeToggle />
      <details class="nav-details">
        <summary class="icon-button" aria-label="导航菜单" title="导航菜单">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <nav aria-label="移动导航">
          <ul class="mobile-nav-list">
            {navigation.map(({ href, label }) => (
              <li><a href={href}>{label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
